# External baseline source snapshots
#
# Keep the runnable source/configuration trees in baselines/, but never add
# local datasets, generated preprocessing artifacts, environments, run output,
# or model weights.  Small, explicitly tracked support files (for example the
# ReactSeq vocabulary) remain available even when they match a broad suffix.
baselines/**/.venv*/
baselines/**/.conda-envs/
baselines/**/.cache/
baselines/**/.deps/
baselines/**/.runtime/
baselines/**/audits/
baselines/*/checkpoints/
baselines/*/models/
baselines/*/trained_models/
baselines/*/outputs/
baselines/*/output/
baselines/*/results/
baselines/*/runs/
baselines/*/logs/
baselines/*/exp/
baselines/*/runtime/
baselines/**/build/
baselines/**/wandb/
baselines/**/*.csv
baselines/**/*.jsonl
baselines/**/*.parquet
baselines/**/*.arrow
baselines/**/*.feather
baselines/**/*.pt
baselines/**/*.pth
baselines/**/*.ckpt
baselines/**/*.safetensors
baselines/**/*.bin
baselines/**/*.idx
baselines/**/*.pkl
baselines/**/*.pickle
baselines/**/*.npy
baselines/**/*.npz
baselines/**/*.so
baselines/**/*.o
baselines/**/*.log
baselines/**/*.pid
baselines/**/errorlog.txt
