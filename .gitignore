!baselines/LocalRetro-main/data/configs/default_config.json
baselines/ReactSeq-main/datasets/*
!baselines/ReactSeq-main/datasets/vocabs/
!baselines/ReactSeq-main/datasets/vocabs/whole_vocabs.src
