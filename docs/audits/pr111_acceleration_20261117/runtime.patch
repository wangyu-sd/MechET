index 0000000..7a8ae85
--- /dev/null
+++ b/src/mechet/route_acceleration.py
@@ -0,0 +1,37 @@
+"""Explicit new sampling condition; defaults never mutate frozen PR110 jobs."""
+from copy import deepcopy
+
+SKIPPED='duplicate_pruned_no_continuation'
+DEFAULT_ACCELERATION=dict(version='pr111_compute_lanes_dynamic_v1',execution_cache_capacity=8192,
+    duplicate_suffix_policy='skip_extra_duplicates_v1',scheduling='global_requests_v1',
+    hf_length_bucketing=True,sampling_kernel='counter_categorical_v1')
+
+
+def validate_acceleration(cfg):
+    value=cfg.get('acceleration')
+    if value is None:return
+    if (not isinstance(value,dict) or set(value)!=set(DEFAULT_ACCELERATION) or
+            any(value[k]!=v for k,v in DEFAULT_ACCELERATION.items() if k!='execution_cache_capacity') or
+            type(value['execution_cache_capacity']) is not int or value['execution_cache_capacity']<1 or
+            not cfg.get('refit') or cfg.get('candidates')!=4 or cfg.get('world_size')!=4 or
+            cfg.get('inference_backend','hf')!='hf'):
+        raise ValueError('ACCELERATION_EXPLICIT_NEW_CONDITION_REQUIRED')
+
+
+def skipped_reward(report):
+    if report.get('status')!=SKIPPED:raise ValueError('NOT_A_BUDGET_SKIPPED_REPORT')
+    return dict(reward=None,process_credit=None,budget_skipped=True,censored=False,
+        verified_stock_closed=False,structural_stock_closed=False,reward_status=SKIPPED,
+        supported_reactions=0,unsupported_reactions=0,
+        chemical_validation='not_evaluated_no_genuine_suffix_return')
+
+
+def attach_execution_cache(episodes,cfg):
+    if not cfg.get('acceleration'):return
+    from .route_execution_cache import ExecutionCache,CachedChemistry
+    cache=cfg.setdefault('_execution_cache',ExecutionCache(cfg['acceleration']['execution_cache_capacity']))
+    from .external_route_data import signature
+    contracts=dict(executor_sources_sha=signature(cfg.get('code_files_sha256',{})),
+        endpoint=cfg['route_endpoint_contract'],material=cfg.get('stock_material_contract'),
+        failure=cfg.get('route_failure_policy'))
+    for ep in episodes:ep.chemistry=CachedChemistry(ep.chemistry,cache,contracts)
diff --git a/src/mechet/route_counter_sampling.py b/src/mechet/route_counter_sampling.py
new file mode 100644
index 0000000..248dc40
--- /dev/null
+++ b/src/mechet/route_counter_sampling.py
@@ -0,0 +1,37 @@
+"""Opt-in categorical draws with request/decode-counter RNG and one GPU search.
+
+This changes the RNG realization, not temperature/top-p/tool distribution.
+The HF outer loop selects the pinned token with argmax; it must not sample a
+second categorical distribution over the pin. Original logprobs are captured
+before pinning. Golden PrivateSampling remains the default.
+"""
+import hashlib
+
+
+class CounterCategorical:
+    def __init__(self,uids,seed,device,capture,*,on_failure=None,prompt_width=0):
+        self.uids=list(uids);self.seed=seed;self.device=device;self.capture=capture;self.step=0
+        self.on_failure,self.prompt_width=on_failure,prompt_width
+
+    def __call__(self,input_ids,scores):
+        import torch
+        logps=self.capture.previous
+        if logps is None:logps=scores.float().log_softmax(-1)
+        probabilities=logps.exp()
+        valid=torch.isfinite(probabilities).all(-1)&(probabilities.sum(-1)>0)
+        if not bool(valid.all()):
+            from .route_sampling_diagnostics import describe_distribution_failure
+            report=describe_distribution_failure(scores,input_ids,bad_rows=(~valid).nonzero().flatten().tolist(),
+                request_ids=self.uids,finished=self.capture.done,decode_step=self.step,prompt_width=self.prompt_width)
+            if self.on_failure:self.on_failure(dict(event='policy-distribution-failure',**report))
+            raise ValueError('INVALID_COUNTER_POLICY_DISTRIBUTION')
+        # 52 bits give strictly interior exactly representable FP64 uniforms.
+        uniforms=[((int.from_bytes(hashlib.sha256(
+            f'{self.seed}:{uid}:{self.step}'.encode()).digest()[:8],'big')>>12)+.5)/2**52
+            for uid in self.uids]
+        u=torch.tensor(uniforms,device=scores.device,dtype=torch.float64)[:,None]
+        cdf=probabilities.cumsum(-1,dtype=torch.float64)
+        cdf=cdf/cdf[:,-1:]
+        chosen=torch.searchsorted(cdf.contiguous(),u,right=True).clamp_max(scores.shape[-1]-1)
+        self.step+=1
+        return torch.full_like(scores,-float('inf')).scatter(1,chosen,0.)
