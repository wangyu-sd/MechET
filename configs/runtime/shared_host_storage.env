# Source before host-side tests, downloads, installs or data processing.
# Data and generated artifacts must not go onto the host's local test disk.
export MECHET_SHARED_HOST_STORAGE=/aaa/fionafyang/buddy1/whaleywang/MechET/outputs/shared_host_storage
export TMPDIR="$MECHET_SHARED_HOST_STORAGE/tmp"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"
export XDG_CACHE_HOME="$MECHET_SHARED_HOST_STORAGE/cache"
export HF_HOME="$XDG_CACHE_HOME/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export PIP_CACHE_DIR="$XDG_CACHE_HOME/pip"
export TORCH_HOME="$XDG_CACHE_HOME/torch"
export TORCH_EXTENSIONS_DIR="$XDG_CACHE_HOME/torch_extensions"
export TRITON_CACHE_DIR="$XDG_CACHE_HOME/triton"
export TORCHINDUCTOR_CACHE_DIR="$XDG_CACHE_HOME/torchinductor"
export MPLCONFIGDIR="$XDG_CACHE_HOME/matplotlib"
export WANDB_DIR="$MECHET_SHARED_HOST_STORAGE/wandb"
export WANDB_CACHE_DIR="$XDG_CACHE_HOME/wandb"
export WANDB_DATA_DIR="$WANDB_DIR/data"
export PYTHONDONTWRITEBYTECODE=1
export PYTEST_DEBUG_TEMPROOT="$TMPDIR"
export PYTEST_ADDOPTS="${PYTEST_ADDOPTS:+$PYTEST_ADDOPTS }-o cache_dir=$XDG_CACHE_HOME/pytest"
mkdir -p -- "$TMPDIR" "$HF_HUB_CACHE" "$HF_DATASETS_CACHE" "$PIP_CACHE_DIR" \
  "$TORCH_HOME" "$TORCH_EXTENSIONS_DIR" "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR" \
  "$MPLCONFIGDIR" "$WANDB_DATA_DIR" "$WANDB_CACHE_DIR" "$XDG_CACHE_HOME/pytest"
