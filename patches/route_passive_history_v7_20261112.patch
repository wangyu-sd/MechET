+"""Complete chemical evidence must not replay old policy prompts or handle IDs."""
+from copy import deepcopy
+import json
+import pytest
+from test_route_event_history import episode
+from test_route_native_history import SystemChemistry,V5
+from test_route_native_last_history import V6
+from test_route_policy_episode import act,finish
+
+V7='route_passive_history_feedback_v7'
+
+
+def populated():
+    from mechet.route_event_history import RouteEventHistory
+    from mechet.trajectory_history import TrajectoryHistory
+    from scripts.run_natural_language_value_search import PROMPT_SUFFIX
+    ledger=RouteEventHistory()
+    ledger.start('r0',dict(occurrence='0',public_product='CO',ancestors=[],level=0),'CO')
+    raw='<tool_call>{"name":"apply_electron_flow","arguments":{"source":"atom A19","destination":"bond B02","older":"past_7.atom15","smiles":"C1CC2CCC-B12"}}</tool_call>'
+    observation=[dict(role='system',content='fixed SYSTEM'),dict(role='user',content=
+        'CURRENT STATE SMILES: CO\nMOLECULAR INVENTORY\n<A01>C<A19>O; B02\n\n'+
+        TrajectoryHistory().render()+PROMPT_SUFFIX)]
+    record=dict(request_id='a0',reaction_id='r0',occurrence='0',raw=raw,
+        feedback=dict(accepted=False,error="KeyError:'A19'",state_changed=False,current_state='CO',
+            instruction='State was not committed. Correct the error and choose another action.'))
+    ledger.record(record,observation,'CO','CO',reaction_committed=False)
+    return ledger
+
+
+def test_passive_view_keeps_all_graphs_actions_errors_and_raw_archive():
+    from mechet.agent_inference import parse_tool_calls
+    ledger=populated();archive=ledger.snapshot()
+    view=ledger.model_view(parse_calls=parse_tool_calls,passive=True,native_system='fixed SYSTEM')
+    text=json.dumps(view)
+    assert view['model_view_version']==7
+    assert len(view['events'])==len(archive['events'])
+    assert view['state_texts']==archive['state_texts']
+    assert 'MOLECULAR INVENTORY' in text and 'CURRENT STATE SMILES: CO' in text
+    assert 'apply_electron_flow' in text and 'KeyError' in text
+    assert 'fixed SYSTEM' not in text
+    assert 'TRAJECTORY HISTORY' not in text and 'accepted_actions:' not in text
+    assert 'Choose the single next' not in text
+    assert 'instruction_at_that_time' not in text
+    assert ledger.snapshot()==archive
+
+
+def test_historical_handles_are_opaque_even_inside_errors_and_previous_scopes():
+    from mechet.agent_inference import parse_tool_calls
+    ledger=populated();view=ledger.model_view(parse_calls=parse_tool_calls,passive=True,native_system='fixed SYSTEM')
+    args=view['past_actions'][0]['calls'][0]['arguments']
+    assert args['source']=='atom past_a.atom_bj'
+    assert args['destination']=='bond past_a.bond_ac'
+    assert args['older']=='past_h.atom_bf'
+    assert args['smiles']=='C1CC2CCC-B12'
+    assert 'atom19' not in json.dumps(view) and 'A19' not in json.dumps(view)
+    feedback=ledger.latest_feedback('r0',scope_aliases=True,opaque_handles=True)
+    assert feedback['error']=="KeyError:'past_a.atom_bj'"
+    assert ledger.latest_feedback('r0')['error']=="KeyError:'A19'"
+
+
+def test_passive_view_preserves_nonidentical_system_and_nonstandard_feedback():
+    from mechet.agent_inference import parse_tool_calls
+    ledger=populated()
+    ledger.data['events'][1]['feedback']['instruction_at_that_time']='Unique recorded observation'
+    view=ledger.model_view(parse_calls=parse_tool_calls,passive=True,native_system='different current system')
+    text=json.dumps(view)
+    assert 'fixed SYSTEM' in text and 'Unique recorded observation' in text
+
+
+def test_passive_view_does_not_discard_unknown_capsule_tail():
+    from mechet.agent_inference import parse_tool_calls
+    ledger=populated()
+    for index,text in enumerate(ledger.data['observation_texts']):
+        if text.startswith('TRAJECTORY HISTORY'):
+            ledger.data['observation_texts'][index]+='\nUnique chemical observation'
+    view=ledger.model_view(parse_calls=parse_tool_calls,passive=True,native_system='fixed SYSTEM')
+    assert 'Unique chemical observation' in json.dumps(view)
+
+
+def test_passive_view_recognizes_the_real_native_formatter_capsule():
+    from mechet.route_policy_episode import RouteEpisode
+    from mechet.route_event_history import HISTORY_HEADER,ACTIVE_HEADER
+    from scripts.run_natural_language_value_search import PROMPT_SUFFIX
+    ep=RouteEpisode(dict(behavior_version='v0',episode_token_budget=10000,
+        public_observation_contract=V6,max_consecutive_recoveries=8),'CO',set(),'real-native',17)
+    act(ep,'finish_trace')
+    archive=ep.event_history.snapshot();ep.cfg['public_observation_contract']=V7
+    req=ep.next_decision()
+    history=json.loads(req.messages[0]['content'].split(HISTORY_HEADER,1)[1].split(ACTIVE_HEADER,1)[0])
+    assert 'TRAJECTORY HISTORY' not in json.dumps(history['ledger'])
+    assert 'TRAJECTORY HISTORY' in req.messages[-1]['content']
+    assert req.messages[-1]['content'].endswith(PROMPT_SUFFIX)
+    assert ep.event_history.snapshot()==archive
+
+
+def test_old_v4_rendering_is_unchanged_by_passive_opt_in():
+    from mechet.agent_inference import parse_tool_calls
+    ledger=populated();before=ledger.model_view(parse_calls=parse_tool_calls)
+    assert before['model_view_version']==4 and 'past_0.atom19' in json.dumps(before)
+    assert 'fixed SYSTEM' in json.dumps(before) and 'TRAJECTORY HISTORY' in json.dumps(before)
+
+
+def test_opaque_handles_preserve_invalid_leading_zero_spellings():
+    from mechet.route_event_history import _past_value
+    keys=['A1','A01','A001','past_7.atom15','past_07.atom15']
+    rendered=_past_value(dict(zip(keys,range(5))),0,opaque=True)
+    assert len(rendered)==5 and len(set(rendered))==5
+    assert set(rendered.values())==set(range(5))
+
+
+def test_v7_has_full_memory_and_feedback_but_only_native_current_policy_instructions():
+    from mechet.route_event_history import HISTORY_HEADER,ACTIVE_HEADER,NATIVE_SYSTEM_HEADER
+    ep=episode();ep.chemistry=SystemChemistry();ep.cfg['public_observation_contract']=V7
+    finish(ep,'CO');act(ep,'finish_trace')
+    req=ep.next_decision();native=ep.chemistry.messages(ep.node)
+    assert req.messages[-1]==native[-1] and req.messages[0]['content'].endswith(native[0]['content'])
+    history,rest=req.messages[0]['content'].split(HISTORY_HEADER,1)[1].split(ACTIVE_HEADER,1)
+    active=json.loads(rest.split(NATIVE_SYSTEM_HEADER,1)[0]);history=json.loads(history)
+    assert history['ledger']['model_view_version']==7
+    assert len(history['ledger']['events'])==len(ep.event_history.data['events'])
+    assert 'instructions' not in active
+    assert active['latest_feedback']['error']=='NONPRODUCTIVE_FINISH'
+    assert active['target']=='CO' and active['accepted_electron_flows']==0
+
+
+def test_v7_restores_mixed_prior_conditions_without_dropping_receipts():
+    from mechet.route_policy_episode import RouteEpisode
+    ep=episode();ep.chemistry=SystemChemistry();finish(ep,'CO')
+    for contract in [V5,V6,V7]:
+        ep.cfg['public_observation_contract']=contract;act(ep,'finish_trace')
+    saved=json.loads(json.dumps(ep.snapshot()))
+    restored=RouteEpisode.restore(saved,chemistry=ep.chemistry)
+    assert restored.next_decision()==ep.next_decision()
+    assert restored.event_history.snapshot()==ep.event_history.snapshot()
+    saved['records'][-1]['messages'][-1]['content']='corrupted native user'
+    with pytest.raises(ValueError,match='HISTORY_RECEIPT_CONTENT_MISMATCH'):
+        RouteEpisode.restore(saved,chemistry=ep.chemistry)
+
+
+@pytest.mark.parametrize('commits,expected',[(1,False),(7,True)])
+def test_v7_smoke_retains_fresh_control_and_strong_commit_gate(commits,expected):
+    from scripts.smoke_route_scoped_history import smoke_arms,behavior_evidence
+    assert smoke_arms(dict(scope='explicit_user_authorized_passive_history_smoke_v1',arms=['native','v7']))==('native','v7')
+    summaries={'native':dict(target_changing_draws=8,productive_finishes=7),
+               'v7':dict(target_changing_draws=8,productive_finishes=commits,missing_atom_errors=0,historical_handle_rejections=0)}
+    results=[dict(arm='v7',case_id=i,target_changing_flow=True) for i in range(4)]
+    assert behavior_evidence(summaries,results,'v7') is expected
