diff --git a/tests/test_route_action_feedback.py b/tests/test_route_action_feedback.py
--- /dev/null
+++ b/tests/test_route_action_feedback.py
@@ -0,0 +1,150 @@
+"""Executable interface regressions, not model/chemistry benchmark results."""
+from copy import deepcopy
+import json
+import pytest
+
+V8='route_action_feedback_v8'
+
+
+def episode():
+    from mechet.external_route_rl import TargetOnlyRouteEpisode
+    return TargetOnlyRouteEpisode(dict(behavior_version='v8-test',public_observation_contract=V8,
+        max_consecutive_recoveries=8,max_action_tokens=2048),'CO',set(),'repair',17)
+
+
+def send(ep,name,args):
+    req=ep.next_decision()
+    ep.accept(dict(request_id=req.request_id,behavior_version=req.behavior_version,
+        raw='<tool_call>'+json.dumps(dict(name=name,arguments=args))+'</tool_call>',
+        prompt_token_ids=[1],generated_token_ids=[2],behavior_logprobs=[-.2],truncated=False))
+
+
+def names(req):return [t['function']['name'] for t in (getattr(req,'tools',None) or [])]
+
+
+def flow(source='the bond between atoms A01 and A99',instruction='first wording'):
+    return dict(direction='retrosynthetic',electron_flow=[dict(source=source,
+        destination='atom A01',instruction=instruction)],bond_order_changes=[],charge_changes=[])
+
+
+def test_fresh_reaction_does_not_offer_finish_and_rejection_cannot_terminalize():
+    ep=episode();req=ep.next_decision()
+    assert names(req)==['import_fragments','apply_electron_flow']
+    before=deepcopy(vars(ep.node));send(ep,'finish_trace',{})
+    assert ep.status is None and vars(ep.node)==before
+    assert ep.records[-1]['error']=='NONPRODUCTIVE_FINISH'
+
+
+def test_rejected_semantic_action_is_not_executed_again_with_new_explanation():
+    from mechet.route_policy_episode import NativeChemistry
+    class Counting(NativeChemistry):
+        calls=0
+        def step(self,node,output):
+            self.calls+=1
+            return super().step(node,output)
+    ep=episode();ep.chemistry=Counting();ep.next_decision()
+    send(ep,'apply_electron_flow',flow());assert ep.chemistry.calls==1
+    before=deepcopy(vars(ep.node))
+    send(ep,'apply_electron_flow',flow(instruction='different explanation'))
+    assert ep.chemistry.calls==1
+    assert vars(ep.node)==before and len(ep.records)==2
+    assert ep.records[-1]['feedback']['repeated_rejected_action'] is True
+    assert ep.records[-1]['feedback']['failure_repeat_count']==2
+    send(ep,'import_fragments',dict(fragments=[dict(smiles='[Cl-]',count=1,purpose='electron_participant')]))
+    assert ep.chemistry.calls==2
+    send(ep,'apply_electron_flow',flow())
+    assert ep.chemistry.calls==3,'a different chemical state must invalidate cached rejection'
+
+
+def test_productive_current_reaction_offers_finish_and_new_target_resets_it():
+    from mechet.natural_language_electron_flow import build_inventory
+    from rdkit import Chem
+    ep=episode();ep.next_decision();inv=build_inventory(ep.node.state)
+    mol=Chem.MolFromSmiles(ep.node.state)
+    aliases={a.GetSymbol():inv.map_to_atom[a.GetAtomMapNum()] for a in mol.GetAtoms() if a.GetSymbol() in ('C','O')}
+    args=flow(source=f"the bond between atoms {aliases['C']} and {aliases['O']}")
+    args['electron_flow'][0]['destination']='atom '+aliases['O']
+    send(ep,'apply_electron_flow',args)
+    assert ep.records[-1]['accepted'] is True
+    assert 'finish_trace' in names(ep.next_decision())
+    send(ep,'finish_trace',{})
+    assert len(ep.reactions)==1 and ep.status is None
+    assert names(ep.next_decision())==['import_fragments','apply_electron_flow']
+    assert ep.node.actions==[] and ep.node.terminal is False
+
+
+def test_history_is_scoped_but_current_rejected_action_and_feedback_are_grounded():
+    ep=episode();ep.next_decision();send(ep,'apply_electron_flow',flow())
+    request=ep.next_decision()
+    system=request.messages[0]['content']
+    assert 'past_' in system and 'A99' not in system
+    user=request.messages[-1]['content']
+    assert 'A99' in user and 'KeyError' in user
+    assert 'CURRENT STATE SMILES:' in user and 'source_bond_candidates' in user
+    archive=ep.event_history.snapshot()
+    assert archive['output_texts'][0]==ep.records[0]['raw'],'raw evidence must remain verbatim'
+
+
+def test_v8_restore_preserves_tools_messages_and_rejection_memory():
+    from mechet.external_route_rl import TargetOnlyRouteEpisode
+    ep=episode();ep.next_decision();send(ep,'apply_electron_flow',flow())
+    saved=json.loads(json.dumps(ep.snapshot()))
+    restored=TargetOnlyRouteEpisode.restore(saved)
+    assert restored.next_decision()==ep.next_decision()
+    send(restored,'apply_electron_flow',flow(instruction='new explanation'))
+    assert restored.records[-1]['feedback']['repeated_rejected_action'] is True
+    bad=deepcopy(saved);bad['records'][0]['messages'][-1]['content']='forged current state'
+    with pytest.raises(ValueError,match='HISTORY_'):
+        TargetOnlyRouteEpisode.restore(bad)
+
+
+def test_legacy_requests_keep_original_tool_schema():
+    from mechet.external_route_rl import TargetOnlyRouteEpisode
+    ep=TargetOnlyRouteEpisode(dict(behavior_version='old',max_action_tokens=2048,
+        public_observation_contract='route_event_history_feedback_v3',max_consecutive_recoveries=8),
+        'CO',set(),'old',17)
+    assert getattr(ep.next_decision(),'tools',None) is None
+
+
+def test_malformed_flow_array_is_rejected_without_crashing_failure_memory():
+    ep=episode();ep.next_decision()
+    args=flow();args['electron_flow']=123
+    send(ep,'apply_electron_flow',args)
+    assert ep.status is None and ep.records[-1]['accepted'] is False
+    send(ep,'apply_electron_flow',args)
+    assert ep.status is None and ep.records[-1]['feedback']['repeated_rejected_action'] is True
+
+
+def test_identical_state_in_another_reaction_does_not_reuse_sibling_failure():
+    from types import SimpleNamespace
+    from mechet.route_action_feedback import state_rejections
+    raw='<tool_call>'+json.dumps(dict(name='finish_trace',arguments={}))+'</tool_call>'
+    ep=SimpleNamespace(uid='route',reactions=[object()],node=SimpleNamespace(state='same exact mapped state'),
+        records=[dict(reaction_id='route/r0',state_before='same exact mapped state',
+                      accepted=False,error='NONPRODUCTIVE_FINISH',raw=raw)])
+    assert state_rejections(ep)=={}
+
+
+@pytest.mark.parametrize('variant',['bond_pair','radical_pair','empty_defaults'])
+def test_executor_equivalent_rejected_actions_share_one_execution(variant):
+    from mechet.route_policy_episode import NativeChemistry
+    class Counting(NativeChemistry):
+        calls=0
+        def step(self,node,output):
+            self.calls+=1
+            return super().step(node,output)
+    ep=episode();ep.chemistry=Counting();ep.next_decision()
+    first=dict(direction='retrosynthetic',electron_flow=[],
+        bond_order_changes=[dict(atoms=['A01','A02'],delta=5)],charge_changes=[])
+    if variant=='radical_pair':
+        first=flow(source='a radical pair on atoms A01 and A02')
+    second=deepcopy(first)
+    if variant=='bond_pair':second['bond_order_changes'][0]['atoms'].reverse()
+    elif variant=='radical_pair':second['electron_flow'][0]['source']='a radical pair on atoms A02 and A01'
+    else:
+        second.pop('electron_flow');second.pop('charge_changes')
+    send(ep,'apply_electron_flow',first)
+    assert not ep.records[-1]['accepted'] and ep.chemistry.calls==1
+    send(ep,'apply_electron_flow',second)
+    assert not ep.records[-1]['accepted'] and ep.chemistry.calls==1
+    assert ep.records[-1]['feedback']['repeated_rejected_action'] is True
diff --git a/tests/test_route_sampler_context_isolation.py b/tests/test_route_sampler_context_isolation.py
--- /dev/null
+++ b/tests/test_route_sampler_context_isolation.py
@@ -0,0 +1,122 @@
+"""CPU software checks: external generation backend is deliberately synthetic."""
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.fixture
+def sampler(tmp_path,monkeypatch):
+    import torch
+    from mechet.route_policy_sampling import NativeRouteSampler
+    import mechet.qwen35_protocol as protocol
+    monkeypatch.setitem(sys.modules,'transformers',SimpleNamespace(
+        GenerationConfig=SimpleNamespace,LogitsProcessorList=list))
+    monkeypatch.setattr(protocol,'tool_prefix',lambda tokenizer,messages,tools:messages[-1]['content'])
+
+    class Tokenizer:
+        pad_token_id=0
+        eos_token_id=2
+        def __call__(self,texts,padding=False,**kwargs):
+            rows=[[1]*len(s) for s in texts]
+            return self.pad({'input_ids':rows},return_tensors='pt') if padding else {'input_ids':rows}
+        def pad(self,encoded,**kwargs):
+            rows=encoded['input_ids'];width=max(map(len,rows))
+            return dict(input_ids=torch.tensor([[0]*(width-len(r))+r for r in rows]),
+                        attention_mask=torch.tensor([[0]*(width-len(r))+[1]*len(r) for r in rows]))
+        def decode(self,tokens,**kwargs):
+            return 'EOS' if tokens==[2] else 'unexpected'
+
+    class Actor(torch.nn.Module):
+        def __init__(self):
+            super().__init__();self.anchor=torch.nn.Parameter(torch.zeros(1))
+        def generate(self,input_ids,attention_mask,logits_processor,**kwargs):
+            scores=torch.full((len(input_ids),4),-float('inf'));scores[:,2]=0.
+            for processor in logits_processor:scores=processor(input_ids,scores)
