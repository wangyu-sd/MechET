+def test_probe_coverage_rejects_split_batches_and_empty_outputs(tmp_path):
+    from scripts.smoke_route_scoped_history import audit_probe_batches
+    path=tmp_path/'probe.jsonl'
+    rows=[dict(event='gpu-returned',requests=[{},{}],generated_token_ids=[[1],[2]])]*2
+    path.write_text('\n'.join(json.dumps(r) for r in rows)+'\n')
+    assert audit_probe_batches(path)['complete'] is False
+    row=dict(event='gpu-returned',requests=[{}]*4,generated_token_ids=[[1],[2],[],[3]])
+    path.write_text(json.dumps(row)+'\n')
+    assert audit_probe_batches(path)['complete'] is False
+    row['generated_token_ids'][2]=[4]
+    path.write_text(json.dumps(row)+'\n')
+    actual=audit_probe_batches(path)
+    assert actual['complete'] is True and actual['physical_batch_sizes']==[4]
+    assert actual['nonempty_outputs']==4
