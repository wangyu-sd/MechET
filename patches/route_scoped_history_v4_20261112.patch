+def test_v4_scopes_only_history_and_keeps_the_current_native_observation_last():
+    ep = episode()
+    ep.cfg['public_observation_contract'] = 'route_scoped_history_feedback_v4'
+    finish(ep, 'CO')
+    act(ep, 'finish_trace')
+    history, active, local = view(ep)
+    assert history['ledger']['model_view_version'] == 4
+    assert local == 'CO'
+    assert active['target'] == 'CO' and active['accepted_electron_flows'] == 0
+    assert active['latest_feedback']['error'] == 'NONPRODUCTIVE_FINISH'
+    from mechet.route_policy_episode import RouteEpisode
+    restored = RouteEpisode.restore(json.loads(json.dumps(ep.snapshot())), chemistry=ep.chemistry)
+    assert restored.next_decision() == ep.next_decision()
+
