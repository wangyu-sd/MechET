+++ b/tests/test_route_native_history.py
@@ -0,0 +1,85 @@
+"""Full route memory must not rewrite the checkpoint-native current user turn."""
+from copy import deepcopy
+import json
+import pytest
+from test_route_event_history import episode
+from test_route_policy_episode import act,finish,Chemistry
+
+V5='route_native_history_feedback_v5'
+
+class SystemChemistry(Chemistry):
+    def messages(self,node):
+        return [{'role':'system','content':'native system'},
+                {'role':'user','content':node.state}]
+
+def configured():
+    ep=episode();ep.chemistry=SystemChemistry();ep.cfg['public_observation_contract']=V5
+    return ep
+
+def test_v5_new_reaction_keeps_native_user_exact_and_all_history_separate():
+    ep=configured();finish(ep,'CO')
+    req=ep.next_decision();native=ep.chemistry.messages(ep.node)
+    assert req.messages[-1]==native[-1]
+    assert req.messages[0]['content'].startswith(native[0]['content'])
+    context=req.messages[0]['content']
+    assert 'COMPLETE ROUTE EVENT HISTORY' in context
+    assert 'CURRENT REACTION' in context
+    assert '"reaction_committed":true' in context
+    assert '"phase":"new_reaction"' in context
+    assert '"target":"CO"' in context
+    assert len(ep.event_history.data['events'])==4
+
+def test_v5_rejection_feedback_retained_without_changing_current_user():
+    ep=configured();act(ep,'finish_trace')
+    native=deepcopy(ep.chemistry.messages(ep.node));archive=ep.event_history.snapshot()
+    req=ep.next_decision()
+    assert req.messages[-1]==native[-1]
+    assert 'NONPRODUCTIVE_FINISH' in req.messages[0]['content']
+    assert '"accepted":false' in req.messages[0]['content']
+    assert '"model_view_version":4' in req.messages[0]['content']
+    assert ep.event_history.snapshot()==archive
+
+def test_v5_restore_keeps_complete_scoped_memory_and_identical_request():
+    from mechet.route_policy_episode import RouteEpisode
+    ep=configured();finish(ep,'CO');act(ep,'finish_trace')
+    restored=RouteEpisode.restore(json.loads(json.dumps(ep.snapshot())),chemistry=ep.chemistry)
+    assert restored.event_history is not None
+    assert restored.next_decision()==ep.next_decision()
+    assert restored.event_history.snapshot()==ep.event_history.snapshot()
+
+def test_v5_single_user_fixture_gets_separate_memory_message():
+    ep=episode();ep.cfg['public_observation_contract']=V5
+    req=ep.next_decision()
+    assert req.messages[-1]==ep.chemistry.messages(ep.node)[-1]
+    assert req.messages[0]['role']=='system'
+    assert req.messages[0]['content'].startswith('\nCOMPLETE ROUTE EVENT HISTORY')
+
+def test_v5_restore_checks_mixed_v3_prefix_and_v5_new_receipts():
+    from mechet.route_policy_episode import RouteEpisode
+    ep=episode();ep.chemistry=SystemChemistry();finish(ep,'CO')
+    ep.cfg['public_observation_contract']=V5
+    act(ep,'finish_trace')
+    saved=json.loads(json.dumps(ep.snapshot()))
+    restored=RouteEpisode.restore(saved,chemistry=ep.chemistry)
+    assert restored.next_decision()==ep.next_decision()
+    saved['records'][-1]['messages'][-1]['content']='tampered current state'
+    with pytest.raises(ValueError,match='HISTORY_RECEIPT_CONTENT_MISMATCH'):
+        RouteEpisode.restore(saved,chemistry=ep.chemistry)
+
+def test_v5_restore_preserves_an_originally_empty_system_message():
+    from mechet.route_policy_episode import RouteEpisode
+    ep=configured()
+    ep.chemistry.messages=lambda node:[{'role':'system','content':''},
+                                      {'role':'user','content':node.state}]
+    act(ep,'finish_trace')
+    saved=json.loads(json.dumps(ep.snapshot()))
+    restored=RouteEpisode.restore(saved,chemistry=ep.chemistry)
+    assert restored.next_decision()==ep.next_decision()
+
+def test_smoke_followup_requires_fresh_native_and_v5_with_fixed_order():
+    from scripts.smoke_route_scoped_history import smoke_arms
+    manifest=dict(scope='explicit_user_authorized_native_history_smoke_v1',arms=['native','v5'])
+    assert smoke_arms(manifest)==('native','v5')
+    with pytest.raises(ValueError,match='ARM_PROTOCOL_MISMATCH'):
+        smoke_arms(dict(manifest,arms=['v5']))
+    assert smoke_arms(dict(scope='explicit_user_authorized_paired_history_smoke_v1'))==('native','v3','v4')
