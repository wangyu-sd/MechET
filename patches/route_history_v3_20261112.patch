+"""Regression tests for complete history and authoritative reaction boundaries."""
+from copy import deepcopy
+import json
+
+import pytest
+
+from test_route_policy_episode import Chemistry, act, finish
+
+
+V3 = 'route_event_history_feedback_v3'
+HISTORY = '\nCOMPLETE ROUTE EVENT HISTORY (PAST EVENTS)\n'
+ACTIVE = '\nCURRENT REACTION (AUTHORITATIVE FOR NEXT ACTION)\n'
+LOCAL = '\nCURRENT LOCAL OBSERVATION\n'
+
+
+def episode(**cfg):
+    from mechet.route_policy_episode import RouteEpisode
+    return RouteEpisode(dict(behavior_version='v0', episode_token_budget=10000,
+        public_observation_contract=V3, max_consecutive_recoveries=8, **cfg),
+        'CCO', {'C', 'O'}, 'events', 17, chemistry=Chemistry())
+
+
+def view(ep):
+    content = ep.next_decision().messages[-1]['content']
+    assert HISTORY in content, 'v3 must expose complete route events'
+    history, rest = content.split(HISTORY, 1)[1].split(ACTIVE, 1)
+    active, local = rest.split(LOCAL, 1)
+    return json.loads(history), json.loads(active), local
+
+
+def test_finish_switches_to_new_target_and_resets_only_active_reaction():
+    ep = episode()
+    finish(ep, 'C.CO')
+    history, active, local = view(ep)
+    assert active['target'] == 'CO' and active['current_state'] == 'CO'
+    assert active['phase'] == 'new_reaction'
+    assert active['accepted_electron_flows'] == 0
+    assert active['latest_feedback'] is None
+    assert active['occurrence'] == '0.1' and local == 'CO'
+    assert history['original_route_target'] == 'CCO'
+    assert history['stock_leaves'] == ['C']
+    assert [e['type'] for e in history['ledger']['events']] == [
+        'reaction_started', 'attempt', 'attempt', 'reaction_started']
+    assert history['ledger']['events'][2]['reaction_committed'] is True
+    assert 'current_state' not in history['ledger']['events'][2]['feedback']
+    assert 'instruction' not in history['ledger']['events'][2]['feedback']
+
+
+def test_new_reaction_failure_feedback_does_not_reuse_completed_reaction_result():
+    ep = episode()
+    finish(ep, 'CO')
+    act(ep, 'finish_trace')
+    history, active, local = view(ep)
+    assert ep.status is None and local == 'CO'
+    assert active['phase'] == 'ongoing_reaction'
+    assert active['accepted_electron_flows'] == 0
+    assert active['latest_feedback']['error'] == 'NONPRODUCTIVE_FINISH'
+    assert active['latest_feedback']['accepted'] is False
+    event = history['ledger']['events'][-1]
+    assert event['before_state_ref'] == event['after_state_ref']
+    assert event['reaction_id'] == active['reaction_id']
+
+
+def test_repeated_observations_are_shared_and_every_decision_is_retained():
+    ep = episode()
+    for _ in range(20):
+        act(ep, 'import_fragments')
+    history, active, _ = view(ep)
+    ledger = history['ledger']
+    attempts = [e for e in ledger['events'] if e['type'] == 'attempt']
+    assert len(attempts) == 20 and len(ep.records) == 20
+    assert len(ledger['observations']) == 1
+    assert len(ledger['output_texts']) == 1
+    assert all(e['observation_ref'] == 0 for e in attempts)
+    assert active['accepted_electron_flows'] == 0
+    assert ep.records[0]['generated_token_ids'] == [1, 2]
+    assert ep.records[-1]['behavior_logprobs'] == [-1., -1.]
+
+
+def test_snapshot_restore_preserves_exact_request_and_rejects_bad_references():
+    from mechet.route_policy_episode import RouteEpisode
+    ep = episode()
+    finish(ep, 'CO')
+    act(ep, 'finish_trace')
+    request = ep.next_decision()
+    snapshot = json.loads(json.dumps(ep.snapshot()))
+    restored = RouteEpisode.restore(snapshot, chemistry=Chemistry())
+    assert restored.next_decision() == request
+    finish(restored, 'O')
