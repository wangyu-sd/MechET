+def _compare_many_equal_spectators(queue):
+    from scripts.build_mech31k_main_product_only_sft import same_chemical_state
+    queue.put(same_chemical_state('O.' * 18 + '[NH4+].[Cl-]',
+                                  'O.' * 17 + '[OH-].N.Cl'))
+
