+            "target_product": "[Br-:3].[CH3:1][OH:2]",
+            "moves": [
+                {"source": {"kind": "LP", "atoms": [2]},
+                 "sink": {"kind": "BOND", "atoms": [1, 2]}},
+                {"source": {"kind": "BOND", "atoms": [1, 3]},
+                 "sink": {"kind": "ATOM", "atoms": [3]}},
