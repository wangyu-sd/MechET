+from types import SimpleNamespace
+import pytest
+
+
+class Chemistry:
+    """Deterministic environment fixture, NOT a chemical/benchmark result."""
+    def root(self, product):
+        return SimpleNamespace(target=product, state=product, actions=[], terminal=False)
+    def messages(self, node):
+        return [{'role':'user','content':node.state}]
+    def step(self, node, output):
+        if output.get('invalid'):
+            return None, 'ILLEGAL_EVENT'
+        return SimpleNamespace(target=node.target, state=output.get('state',node.state),
+            actions=node.actions+[{'name':output['name']}], terminal=output['name']=='finish_trace'), ''
+    def precursors(self, node, initial):
+        return node.state
+
+
+def episode(stock=('C','O'), budget=100):
+    from mechet.route_policy_episode import RouteEpisode
+    return RouteEpisode({'behavior_version':'v0','episode_token_budget':budget}, 'CCO', set(stock),
+                        'e0', 17, chemistry=Chemistry())
+
+
+def act(ep, name, state=None, **extra):
+    request = ep.next_decision()
+    receipt = dict(request_id=request.request_id, behavior_version='v0',
+                   generated_token_ids=[1,2], behavior_logprobs=[-1.,-1.],
+                   prompt_token_ids=[3], raw='fixture', name=name, **extra)
+    if state is not None:
+        receipt['state']=state
+    ep.accept(receipt)
+
+
+def finish(ep, state):
+    act(ep, 'apply_electron_flow', state)
+    act(ep, 'finish_trace')
+
+
+def test_finish_closes_one_reaction_not_whole_and_route():
+    ep = episode()
+    finish(ep,'C.CO')
+    assert ep.status is None and ep.reward is None
+    assert ep.next_decision().product == 'CO'
+    finish(ep,'O')
+    report=ep.finish_report()
+    assert report['status']=='stock_solved' and report['reward']==1
+    assert len(report['reactions'])==2 and len(report['records'])==4
+    assert report['depth']==2 and sorted(report['stock_leaves'])==['C','O']
+
+
+def test_zero_step_no_flow_no_change_and_cycle_cannot_reward():
+    from mechet.route_policy_episode import RouteEpisode
+    stock=RouteEpisode({'behavior_version':'v0','episode_token_budget':100},'C',{'C'},'z',1,chemistry=Chemistry())
+    assert stock.finish_report()['status']=='already_stock' and stock.reward==0
+    ep=episode(); act(ep,'finish_trace','C')
+    assert ep.status=='nonproductive_finish' and ep.reward==0
+    ep=episode(); finish(ep,'CO'); finish(ep,'CCO')
+    assert ep.status=='cycle' and ep.reward==0
+    ep=episode(); finish(ep,'CCO')
+    assert ep.status=='nonproductive_finish'
+
+
+def test_sibling_duplicates_are_not_ancestry_cycles_and_all_occurrences_preserved():
+    ep=episode(); finish(ep,'CO.CO'); finish(ep,'O'); finish(ep,'O')
