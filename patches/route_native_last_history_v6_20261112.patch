+++ b/tests/test_route_native_last_history.py
@@ -0,0 +1,65 @@
+"""Original one-decision policy instructions must follow historical context."""
+import json
+import pytest
+from test_route_event_history import episode
+from test_route_policy_episode import act,finish
+from test_route_native_history import SystemChemistry,V5
+
+V6='route_native_last_history_feedback_v6'
+
+
+def configured():
+    ep=episode();ep.chemistry=SystemChemistry();ep.cfg['public_observation_contract']=V6
+    return ep
+
+
+def test_v6_full_memory_precedes_exact_native_system_and_user():
+    ep=configured();finish(ep,'CO')
+    req=ep.next_decision();native=ep.chemistry.messages(ep.node)
+    assert req.messages[-1]==native[-1]
+    content=req.messages[0]['content']
+    assert content.startswith('\nCOMPLETE ROUTE EVENT HISTORY')
+    assert content.endswith(native[0]['content'])
+    assert '"reaction_committed":true' in content
+    assert '"phase":"new_reaction"' in content
+    assert '"model_view_version":4' in content
+
+
+def test_v6_restore_accepts_mixed_v3_v5_v6_and_keeps_feedback():
+    from mechet.route_policy_episode import RouteEpisode
+    ep=episode();ep.chemistry=SystemChemistry();finish(ep,'CO')
+    ep.cfg['public_observation_contract']=V5;act(ep,'finish_trace')
+    ep.cfg['public_observation_contract']=V6;act(ep,'finish_trace')
+    restored=RouteEpisode.restore(json.loads(json.dumps(ep.snapshot())),chemistry=ep.chemistry)
+    assert restored.next_decision()==ep.next_decision()
+    assert 'NONPRODUCTIVE_FINISH' in restored.next_decision().messages[0]['content']
+
+
+def test_v6_single_user_and_empty_system_restore_without_losing_native_turn():
+    from mechet.route_policy_episode import RouteEpisode
+    for empty_system in (False,True):
+        ep=episode();ep.cfg['public_observation_contract']=V6
+        if empty_system:
+            ep.chemistry.messages=lambda node:[{'role':'system','content':''},{'role':'user','content':node.state}]
+        act(ep,'finish_trace')
+        saved=json.loads(json.dumps(ep.snapshot()))
+        restored=RouteEpisode.restore(saved,chemistry=ep.chemistry)
+        assert restored.next_decision()==ep.next_decision()
+        assert restored.next_decision().messages[-1]==ep.chemistry.messages(ep.node)[-1]
+
+def test_v6_smoke_uses_fresh_native_control_and_unchanged_two_draw_protocol():
+    from scripts.smoke_route_scoped_history import smoke_arms
+    manifest=dict(scope='explicit_user_authorized_native_last_history_smoke_v1',arms=['native','v6'])
+    assert smoke_arms(manifest)==('native','v6')
+    with pytest.raises(ValueError,match='ARM_PROTOCOL_MISMATCH'):
+        smoke_arms(dict(manifest,arms=['v6']))
+
+
+@pytest.mark.parametrize('arm,commits,expected',[('v6',1,False),('v6',7,True),('v5',1,True)])
+def test_v6_requires_productive_commits_as_well_as_temporary_structure_changes(arm,commits,expected):
+    from scripts.smoke_route_scoped_history import behavior_evidence
+    native=dict(target_changing_draws=8,productive_finishes=7)
+    candidate=dict(target_changing_draws=8,productive_finishes=commits,missing_atom_errors=0,historical_handle_rejections=0)
+    summaries={'native':native,arm:candidate}
+    results=[dict(arm=arm,case_id=i,target_changing_flow=True) for i in range(4)]
+    assert behavior_evidence(summaries,results,arm) is expected
